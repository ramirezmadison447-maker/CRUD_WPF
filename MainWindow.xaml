<Window x:Class="CRUD_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.503,0.501" Margin="0,0,0,-5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform Angle="-0.023"/>
                <TranslateTransform X="-0.001" Y="-0.001"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Nombre:" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="20,51,0,0" VerticalAlignment="Top" Width="104" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" Background="#FFF1BDBD"/>
        <Label Content="Edad:" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="20,116,0,0" VerticalAlignment="Top" Width="104" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" Background="#FFF1BDBD"/>
        <Button x:Name="limpiar_btn" Content="Limpiar" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="475,50,0,0" VerticalAlignment="Top" Width="109" Height="37" Click="Limpiar_btn" Background="#FFD1E1E2" FontWeight="Bold"/>
        <Button x:Name="update_btn" Content="Update" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="633,51,0,0" VerticalAlignment="Top" Width="109" Height="37" Click="Update_btn" Background="#FF81E44C" FontWeight="Bold"/>
        <Button x:Name="delete_btn" Content="Delete" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="475,117,0,0" VerticalAlignment="Top" Width="109" Height="37" Click="Delete_btn" Background="#FF81E44C" FontWeight="Bold"/>
        <Button x:Name="agregar_btn" Content="Agregar" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="636,118,0,0" VerticalAlignment="Top" Width="109" Height="37" Click="Agregar_btn" Background="#FF81E44C" FontWeight="Bold"/>
        <DataGrid x:Name="dgPersonas"
          Grid.ColumnSpan="2"
          Margin="-1,157,0,6"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionChanged="DataGrid_SelectionChanged_1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Edad"   Binding="{Binding Edad}"   Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox x:Name="txtNombre" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="137,53,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="242" Height="31" RenderTransformOrigin="0.5,0.5">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.011"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <TextBox x:Name="txtEdad" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="135,118,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="244" Height="29"/>

    </Grid>
</Window>
